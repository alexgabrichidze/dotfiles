#!/bin/sh

device=$(
  upower -e |
    while IFS= read -r path; do
      info=$(upower -i "$path" 2>/dev/null) || continue
      printf '%s\n' "$info" | grep -q 'model:.*Logitech G502 X LS' || continue
      printf '%s\n' "$path"
      break
    done
)

if [ -z "$device" ]; then
  printf '{"text":"","tooltip":"G502 not found","class":"missing"}\n'
  exit 0
fi

info=$(upower -i "$device" 2>/dev/null) || {
  printf '{"text":"","tooltip":"G502 unavailable","class":"missing"}\n'
  exit 0
}

model=$(printf '%s\n' "$info" | awk -F': *' '/model:/ {print $2; exit}')
state=$(printf '%s\n' "$info" | awk -F': *' '/state:/ {print $2; exit}')
percentage=$(printf '%s\n' "$info" | awk -F': *' '/percentage:/ {gsub(/%/, "", $2); print $2; exit}')
warning=$(printf '%s\n' "$info" | awk -F': *' '/warning-level:/ {print $2; exit}')

[ -n "$model" ] || model="Logitech G502 X LS"
[ -n "$state" ] || state="unknown"

case "$percentage" in
  ''|*[!0-9]*)
    printf '{"text":"","tooltip":"G502 battery unknown","class":"missing"}\n'
    exit 0
    ;;
esac

case "$state" in
  charging)
    suffix=" chg"
    class="charging"
    ;;
  fully-charged)
    suffix=""
    class="full"
    ;;
  pending-charge)
    suffix=" wait"
    class="charging"
    ;;
  pending-discharge)
    suffix=" hold"
    class="discharging"
    ;;
  empty)
    suffix=" empty"
    class="critical"
    ;;
  *)
    suffix=""
    class="discharging"
    ;;
esac

if [ "$warning" = "critical" ] || [ "$percentage" -le 10 ]; then
  class="critical"
elif [ "$warning" = "low" ] || [ "$percentage" -le 20 ]; then
  class="low"
fi

printf '{"text":"g502 %s%%%s","tooltip":"%s - %s","class":"%s","percentage":%s}\n' \
  "$percentage" "$suffix" "$model" "$state" "$class" "$percentage"
